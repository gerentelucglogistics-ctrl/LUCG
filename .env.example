# Copia a apps/api/.env, apps/web/.env.local y apps/driver/.env.local según corresponda.
# Valores locales: salida de `supabase status`.

# --- API / worker ---
APP_ENV=local
DATABASE_URL=postgresql+psycopg://lucg_api:lucg_api@127.0.0.1:55322/postgres
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_JWKS_URL=http://127.0.0.1:55321/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_SERVICE_KEY=
STORAGE_BUCKET_EVIDENCIAS=evidencias
STORAGE_BUCKET_IMPORTACIONES=importaciones
SENTRY_DSN=
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
CORS_ORIGIN_REGEX=
# Solo pruebas (rol postgres local; nunca en alojado)
DATABASE_URL_ADMIN=postgresql+psycopg://postgres:postgres@127.0.0.1:55322/postgres

# --- Apps web (prefijo VITE_) ---
VITE_APP_ENV=local
VITE_API_URL=http://localhost:8000/api/v1
VITE_SUPABASE_URL=http://127.0.0.1:55321
# Lleva la clave publishable `sb_publishable_...` (no la anon JWT heredada)
VITE_SUPABASE_ANON_KEY=
VITE_SENTRY_DSN=

# --- Playwright contra entornos ---
BASE_URL_WEB=http://localhost:5173
BASE_URL_DRIVER=http://localhost:5174
BASE_URL_API=http://localhost:8000
E2E_USER_ADMIN=
E2E_PASS_ADMIN=
E2E_USER_REPARTIDOR=
E2E_PASS_REPARTIDOR=
BASE_URL_SITE=http://localhost:3000
BASE_URL_SITE_PROD=
BASE_URL_SITE_PREVIEW=
VERCEL_BYPASS_SITE=
VERCEL_BYPASS_WEB=
VERCEL_BYPASS_DRIVER=
E2E_SUPABASE_URL=http://127.0.0.1:55321
E2E_SUPABASE_PUBLISHABLE_KEY=
