{
  "model": "opus",
  "permissions": {
    "defaultMode": "bypassPermissions",
    "deny": [
      "Bash(supabase db reset --linked*)",
      "Bash(supabase db reset --remote*)",
      "Bash(supabase db push*--remote*)",
      "Bash(supabase db push*--linked*)",
      "Bash(supabase link*)",
      "Bash(supabase migration repair*)",
      "Bash(gh workflow run deploy-prod*)",
      "Bash(railway up*--environment prod*)",
      "Bash(vercel deploy --prod*)",
      "Bash(vercel --prod*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push origin main*)",
      "Bash(gh pr review*--approve*)",
      "Bash(gh auth token*)",
      "Bash(gh auth switch*)",
      "Bash(gh auth login*)",
      "Bash(gh auth refresh*)",
      "Bash(gh secret set*--env prod*)",
      "Bash(gh secret set*-e prod*)",
      "Bash(gh secret set*Production*)",
      "Bash(gh variable set*--env prod*)",
      "Bash(gh variable set*-e prod*)",
      "Bash(gh variable set*Production*)",
      "Bash(gh secret delete*prod*)",
      "Bash(gh variable delete*prod*)",
      "Bash(gh workflow run migrate*prod*)",
      "Bash(git push*refs/heads/main*)",
      "Bash(git push --all*)",
      "Bash(git push --mirror*)",
      "Bash(security dump-keychain*)",
      "Bash(gh pr create*--base main*)",
      "Bash(gh pr create*--base=main*)",
      "Bash(gh pr create*-B main*)",
      "Bash(gh pr edit*--base main*)",
      "Bash(gh pr edit*-B main*)",
      "Bash(rm -rf /*)",
      "Read(./.env)",
      "Read(./.env.prod)",
      "Read(./.env.dev)",
      "Read(./.env.local)",
      "Read(./apps/api/.env)",
      "Read(./apps/web/.env.local)",
      "Read(./apps/driver/.env.local)",
      "Read(./apps/site/.env.local)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guardia-prod.sh\""
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gsd-prompt-guard.js",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gsd-read-guard.js",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gsd-workflow-guard.js",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gsd-validate-commit.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gsd-check-update.js"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gsd-session-state.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gsd-context-monitor.js",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gsd-read-injection-scanner.js",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gsd-phase-boundary.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
