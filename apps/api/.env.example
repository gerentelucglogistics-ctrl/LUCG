APP_ENV=local
APP_VERSION=dev
DATABASE_URL=postgresql+psycopg://lucg_api:lucg_api@127.0.0.1:55322/postgres
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_JWKS_URL=http://127.0.0.1:55321/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_SERVICE_KEY=
STORAGE_BUCKET_EVIDENCIAS=evidencias
STORAGE_BUCKET_IMPORTACIONES=importaciones
SENTRY_DSN=
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Regex de orígenes CORS adicionales (solo dev, p. ej. previews de Vercel). Vacío = solo CORS_ORIGINS exactos.
CORS_ORIGIN_REGEX=
# Solo pruebas locales (test_rls); nunca en Railway.
DATABASE_URL_ADMIN=postgresql+psycopg://postgres:postgres@127.0.0.1:55322/postgres
# En Railway, DATABASE_URL usa el pooler de sesión de Supabase:
# postgresql+psycopg://lucg_api.<ref>:<clave>@aws-<N>-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
