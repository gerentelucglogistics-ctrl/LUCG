{
  "name": "lucg-plataforma",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "e2e": "playwright test --project=local",
    "e2e:preview": "playwright test --project=preview",
    "e2e:dev": "playwright test --project=dev --project=dev-driver",
    "gen-client": "pnpm --filter @lucg/api-client gen"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  }
}
